# =============================================================
# Plantilla de entorno para la VM OCI (perfil prod / BD local).
# Copiar a env.oci y completar. NO versionar env.oci.
#
#   cp env.oci.example env.oci
# =============================================================

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- PostgreSQL en la misma VM (localhost) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/miapp
SPRING_DATASOURCE_USERNAME=oracleone18
SPRING_DATASOURCE_PASSWORD=cambia_esta_password

# --- JWT (minimo 32 bytes; genera uno propio en la VM) ---
# Ejemplo: openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto-por-uno-seguro-de-al-menos-32-bytes
JWT_EXPIRATION_MS=86400000

# --- Modelo ---
APP_MODELO_ESTRATEGIA=onnx

# --- Recomendaciones Gemini (hibrido: reglas eligen temas; Gemini reformula) ---
APP_RECOMENDACIONES_MODO=hibrido
APP_RECOMENDACIONES_MAX_ITEMS=3
APP_RECOMENDACIONES_GEMINI_MODELO=gemini-2.5-flash-lite
APP_RECOMENDACIONES_GEMINI_TIMEOUT_MS=8000
GEMINI_API_KEY=

# --- CORS (ajusta si el frontend apunta a la IP publica) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- OAuth2 Google (opcional en la VM) ---
# Deploy vía scripts/deploy-oci.sh deja ENABLED=true y callback en http://<IP>:8080/...
# Para prueba solo local en la VM / tunnel SSH:
APP_OAUTH2_ENABLED=false
APP_OAUTH2_SUCCESS_REDIRECT=http://localhost:8080/oauth-callback.html
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
