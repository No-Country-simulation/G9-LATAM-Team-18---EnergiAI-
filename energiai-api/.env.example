# =============================================
# EnergiAI API - Variables de Entorno
# =============================================
# Copiar a .env y completar. NO versionar el .env real.
# Preferible: definir estas vars en ~/.profile (bloque ENERGIAI).
#
# LEYENDA:
#   [OBLIGATORIO]  - Requerido para que la app funcione
#   [RECOMENDADO]  - Tiene default, pero deberías cambiarlo en producción
#   [OPCIONAL]     - Funciona sin configurar
# =============================================

# ---------------------------------------------
# BASE DE DATOS POSTGRESQL [OBLIGATORIO]
# ---------------------------------------------
# Partes del string de conexión (para docker-compose o scripts)
ENERGIAI_DB_HOST=146.181.33.44
ENERGIAI_DB_PORT=5432
ENERGIAI_DB_NAME=miapp

# Credenciales para contenedor PostgreSQL
POSTGRES_DB=miapp
POSTGRES_USER=oracleone18
POSTGRES_PASSWORD=cambia_esta_password

# Datasource (Spring Boot) [OBLIGATORIO]
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://${ENERGIAI_DB_HOST}:${ENERGIAI_DB_PORT}/${ENERGIAI_DB_NAME}
SPRING_DATASOURCE_USERNAME=oracleone18
SPRING_DATASOURCE_PASSWORD=cambia_esta_password

# ---------------------------------------------
# JWT [OBLIGATORIO en producción]
# ---------------------------------------------
# El secreto DEBE tener al menos 32 bytes. Generar uno seguro:
#   openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto-por-uno-seguro-de-al-menos-32-bytes
JWT_EXPIRATION_MS=86400000

# ---------------------------------------------
# CORS [RECOMENDADO]
# ---------------------------------------------
# Orígenes del frontend separados por coma (sin espacios).
# Incluye Netlify (prod), localhost:3000 (React/CRA), localhost:5173 (Vite).
APP_CORS_ALLOWED_ORIGINS=https://energi-ai.netlify.app,http://localhost:3000,http://localhost:5173

# ---------------------------------------------
# OAUTH2 - GOOGLE [OPCIONAL]
# ---------------------------------------------
# Dos modos de uso:
#   1. Browser flow (redirect): requiere APP_OAUTH2_ENABLED=true
#   2. API/SPA (token exchange): POST /api/auth/oauth/google siempre disponible
#
# Para producción con frontend en Netlify, usar solo el API flow (modo 2).
# Ver docs/OAUTH_PRODUCCION.md para configuración completa.

APP_OAUTH2_ENABLED=false
APP_OAUTH2_SUCCESS_REDIRECT=/oauth-callback.html

# Obtener en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook [OPCIONAL]
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------
# RECOMENDACIONES IA [OPCIONAL]
# ---------------------------------------------
# Modos: reglas | hibrido | gemini
#   - reglas: solo reglas locales (sin API externa)
#   - hibrido: reglas eligen temas, Gemini reformula (fallback a reglas)
#   - gemini: Gemini genera todo (fallback a reglas)
APP_RECOMENDACIONES_MODO=hibrido
APP_RECOMENDACIONES_MAX_ITEMS=3

# API Key de Gemini (https://aistudio.google.com/apikey)
# Preferible exportar desde ~/.profile (no versionar)
GEMINI_API_KEY=
APP_RECOMENDACIONES_GEMINI_MODELO=gemini-2.5-flash-lite
APP_RECOMENDACIONES_GEMINI_TIMEOUT_MS=8000

# ---------------------------------------------
# MODELO Y COSTOS [OPCIONAL]
# ---------------------------------------------
# Estrategia de clasificación: onnx (default) | local (softmax JSON)
APP_MODELO_ESTRATEGIA=onnx

# Umbrales de costos: metricas_final (default) | parametros
# APP_COSTOS_UMBRALES=metricas_final

# ---------------------------------------------
# SERVIDOR [OPCIONAL]
# ---------------------------------------------
SERVER_PORT=8080

# Pool de conexiones (default: 5)
DB_POOL_SIZE=5

# Hibernate DDL (default: none, Flyway maneja el schema)
JPA_DDL_AUTO=none
