# Copiar a .env y completar. NO versionar el .env real.
# Preferible: definir estas vars en ~/.profile (bloque ENERGIAI).

# Base de datos PostgreSQL (partes del string de conexion)
ENERGIAI_DB_HOST=146.181.33.44
ENERGIAI_DB_PORT=5432
ENERGIAI_DB_NAME=miapp

POSTGRES_DB=miapp
POSTGRES_USER=oracleone18
POSTGRES_PASSWORD=cambia_esta_password

# Datasource (Spring Boot)
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://${ENERGIAI_DB_HOST}:${ENERGIAI_DB_PORT}/${ENERGIAI_DB_NAME}
SPRING_DATASOURCE_USERNAME=oracleone18
SPRING_DATASOURCE_PASSWORD=cambia_esta_password

# JWT (usar un secreto de al menos 32 bytes)
JWT_SECRET=cambiar-este-secreto-por-uno-seguro-de-al-menos-32-bytes
JWT_EXPIRATION_MS=86400000

# CORS (origenes del frontend)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth2 (opcional). Browser: APP_OAUTH2_ENABLED=true + client-id/secret.
# API/Postman: POST /api/auth/oauth/google|facebook con id_token / access_token
# (Google id_token se valida contra GOOGLE_CLIENT_ID si esta definido).
APP_OAUTH2_ENABLED=false
APP_OAUTH2_SUCCESS_REDIRECT=http://localhost:8080/oauth-callback.html
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Recomendaciones hibridas (reglas eligen temas; Gemini reformula; fallback a reglas)
# APP_RECOMENDACIONES_MODO=reglas|hibrido|gemini
APP_RECOMENDACIONES_MODO=hibrido
APP_RECOMENDACIONES_MAX_ITEMS=3
# Preferible exportar GEMINI_API_KEY desde ~/.profile (no versionar)
GEMINI_API_KEY=
APP_RECOMENDACIONES_GEMINI_MODELO=gemini-2.5-flash-lite
APP_RECOMENDACIONES_GEMINI_TIMEOUT_MS=8000

# Costos estacionales (solo usuario autenticado). Default: umbrales hoja metricas_final.
# Rollback a hoja Parametros (sin recompilar): APP_COSTOS_UMBRALES=parametros
# APP_COSTOS_UMBRALES=metricas_final
# APP_COSTOS_RUTA=classpath:model/parametros_costos.json
